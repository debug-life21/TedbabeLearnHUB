# ----------------------------------------------------
# LearnHUB Server Environment Configuration Template
# ----------------------------------------------------

# Runtime Environment (development | production | test)
NODE_ENV=development
PORT=4000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/learnhub

# Frontend Client URLs (CORS allowed origins)
CLIENT_URL=http://localhost:5173
ADMIN_CLIENT_URL=http://localhost:5174

# Authentication & Security
JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-chars
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# SMTP Transactional Email Service
# In development, if SMTP_USER is blank, verification codes and reset links are safely logged to console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LearnHUB <no-reply@learnhub.et>"

# Initial Super Admin Bootstrapping
ADMIN_EMAIL=admin@learnhub.et
ADMIN_PASSWORD=change-this-secure-admin-password
SEED_DEMO_DATA=false

# File storage: use local for development or r2 for Cloudflare R2 object storage.
STORAGE_PROVIDER=local
# Create a private bucket and an R2 API token scoped to that bucket.
R2_ACCOUNT_ID=
R2_BUCKET=learnhub-resources
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Google Calendar & Meet API (Optional OAuth Integration)
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# ----------------------------------------------------
# Payments (Module 3)
# ----------------------------------------------------
# Master switch. Paid checkout, webhooks and reconciliation stay disabled until true.
PAYMENTS_ENABLED=false
# sandbox | live — stamped on every order and transaction for reporting.
PAYMENT_ENVIRONMENT=sandbox
# Public HTTPS base URL of THIS API, used to build callback/notify URLs.
# Example: https://learnhub-api.onrender.com
SERVER_PUBLIC_URL=

# --- Chapa (self-serve sandbox keys: https://dashboard.chapa.co) ---
CHAPA_SECRET_KEY=
# The webhook secret you set in the Chapa dashboard when registering the
# webhook URL {SERVER_PUBLIC_URL}/api/payments/webhook/chapa
CHAPA_WEBHOOK_SECRET=
CHAPA_BASE_URL=https://api.chapa.co/v1
# Chapa's published domestic fee, used to estimate net revenue.
CHAPA_FEE_PERCENT=2.5

# --- Telebirr (all values issued by Ethio Telecom at merchant onboarding) ---
# The production gateway endpoint comes from Ethio Telecom. Do not guess it.
TELEBIRR_BASE_URL=
TELEBIRR_FABRIC_APP_ID=
TELEBIRR_APP_SECRET=
TELEBIRR_MERCHANT_APP_ID=
TELEBIRR_MERCHANT_CODE=
# PEM strings; "\\n" escapes are converted to real newlines on load.
TELEBIRR_PRIVATE_KEY=
TELEBIRR_PUBLIC_KEY=
TELEBIRR_NOTIFY_URL=
TELEBIRR_RETURN_URL=
TELEBIRR_FEE_PERCENT=0
